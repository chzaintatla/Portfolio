# --- Core ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sparkwave:sparkwave@localhost:5432/sparkwave
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=720
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# First admin created by `python -m app.seed.seed`
ADMIN_EMAIL=admin@sparkwave.dev
ADMIN_PASSWORD=change-me-now

# --- Frontend revalidation (on-demand ISR after CMS edits) ---
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-too

# --- Email (SMTP). Leave SMTP_HOST empty to log emails instead of sending ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SparkWave Digital Systems <connect@sparkwave.dev>
ADMIN_NOTIFY_EMAIL=connect@sparkwave.dev

# --- Storage: local | cloudinary | s3 ---
STORAGE_BACKEND=local
CLOUDINARY_URL=
S3_BUCKET=
S3_REGION=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
